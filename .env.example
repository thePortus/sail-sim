# ─────────────────────────────────────────────────────────────────────────────
# Local environment overrides. Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# ".env" is gitignored — never commit your real keys.
#
# docker-compose.yml reads this file automatically for ${VAR} substitution.
# Host-run terrain build scripts read it too (via server/config/terrain.config.js).
# ─────────────────────────────────────────────────────────────────────────────

# OpenTopography API key — used by the terrain source-fetch tooling to pull
# Copernicus GLO-30 elevation tiles via the OpenTopography global-DEM REST API.
# Get a free key: https://portal.opentopography.org  →  log in  →  MyOpenTopo  →  request an API key.
OPENTOPO_API_KEY=
