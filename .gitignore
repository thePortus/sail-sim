# === OS Files ===
.DS_Store
Thumbs.db
.vscode/
.claude/
CLAUDE.md
certbot/
*/coverage/

# === Local secrets / env ===
# Real keys live in .env (gitignored); .env.example is the tracked template.
.env
.env.*
!.env.example

# Sparkle/WinSparkle update-signing key. The Ed25519 PRIVATE key must never be committed — back it up
# securely; losing it breaks auto-updates for every installed client. The public key is safe (it ships in the
# client build), but the whole dir is ignored for simplicity.
server/.sparkle/

# Built client release artifacts served at /client (large binaries + the generated appcast feeds, produced by
# server/scripts/client-release.js). The dir scaffolding (README) is tracked; the outputs are not.
server/assets/client/*.zip
server/assets/client/*.dmg
server/assets/client/*.exe
server/assets/client/*.tar.gz
server/assets/client/appcast-*.xml

# generated terrain files
server/assets/terrain/
server/assets/geometry/terrain/biome/

# code graph
graphify-out

# downloaded terrain source rasters (re-fetchable via npm run fetch:terrain-sources)
server/assets/maps/sources/

# downloaded sky textures (re-fetchable via npm run download:sky-textures)
server/assets/sky/

# downloaded CC0 scatter textures (re-fetchable via npm run download:scatter-textures)
# runtime (served) set + raw authoring sources for Blender re-bakes — neither is committed.
server/assets/geometry/scatter/cc0/
server/assets/scatter-src/

# downloaded CC0 ship-wood textures (re-fetchable via npm run download:ship-wood)
# authoring-only source baked into the ship GLBs in Blender — never served, never committed.
server/assets/ship-wood-src/

# downloaded CC0 coquina fort-stone textures (re-fetchable via npm run download:fort-stone)
# authoring-only source skinned onto the fort GLBs in Blender — never served, never committed.
server/assets/fort-stone-src/

# user info
server/seeders/import/**/*

# Static Generated doc files
server/pages/docs

