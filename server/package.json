{
  "name": "sail-sim",
  "version": "0.0.1",
  "description": "Jesuit Catalogs Database - Server",
  "private": true,
  "contributors": [
    {
      "name": "David J. Thomas",
      "email": "thomaei@bc.edu",
      "url": "https://theport.us"
    }
  ],
  "scripts": {
    "start": "npx postcss ./pages/tailwind.css -o ./pages/tailwind.min.css && npx apidoc -i . -o pages/docs/ && NODE_ENV=production node server.js",
    "build:terrain-geometry": "node scripts/build-terrain.js",
    "download:terrain-tiles": "node scripts/download-terrain-tiles.js",
    "build:terrain": "npm run build:terrain-geometry && npm run download:terrain-tiles",
    "test": "cross-env NODE_ENV=test jest --collect-coverage --testTimeout=10000 --detectOpenHandles",
    "pretest": "npx postcss ./pages/tailwind.css -o ./pages/tailwind.min.css && cross-env NODE_ENV=test npm run migrate:reset --env=test",
    "migrate:reset": "npx sequelize-cli db:migrate:undo:all --env=production && npm run migrate --env=production",
    "migrate": "npx sequelize-cli db:migrate --env=production && npx sequelize-cli db:seed:all --env=production && sleep 2"
  },
  "keywords": [
    "dh",
    "digital humanities",
    "digital scholarship",
    "jesuit studies",
    "history",
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "rest",
    "api"
  ],
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^6.4.0",
    "jsonwebtoken": "^9.0.0",
    "md5": "^2.3.0",
    "mysql2": ">=3.9.8",
    "pngjs": "^7.0.0",
    "sequelize": "^6.21.3",
    "sequelize-cli": "^6.6.0",
    "serve-favicon": "^2.5.0",
    "util": "^0.12.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.30.7",
    "@typescript-eslint/parser": "^5.30.7",
    "apidoc": "^1.2.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.20.0",
    "jest": "^29.5.0",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "./node_modules/"
    ]
  },
  "apidoc": {
    "title": "API Documentation for the Jesuit Catalogs Database Project",
    "url": "localhost:8080",
    "sampleURL": true,
    "showRequiredLabels": true
  }
}
